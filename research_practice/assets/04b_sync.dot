digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.16,0.10", fontsize=12];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  tracee_grp [label="", fillcolor="white", color="#2F9D57", shape=box, style="rounded,filled", penwidth=2.4, fixedsize=true, width="3.6", height="5.6", pos="200,372"];
  center_grp [label="", fillcolor="white", color="#6F42C1", shape=box, style="rounded,filled", penwidth=2.4, fixedsize=true, width="3.6", height="2.35", pos="500,372"];
  tracer_grp [label="", fillcolor="white", color="#C8881A", shape=box, style="rounded,filled", penwidth=2.4, fixedsize=true, width="3.6", height="5.6", pos="800,372"];
  tracee_t [shape=plaintext, style="filled", fillcolor="white", fontname="PingFang SC", fontcolor="#1c6035", fontsize="14", label=<<B>tracee 线程</B>>, pos="200,552"];
  center_t [shape=plaintext, style="filled", fillcolor="white", fontname="PingFang SC", fontcolor="#48227f", fontsize="14", label=<<B>TraceeStatus 共享对象</B>>, pos="500,435"];
  tracer_t [shape=plaintext, style="filled", fillcolor="white", fontname="PingFang SC", fontcolor="#7a5200", fontsize="14", label=<<B>tracer 线程</B>>, pos="800,552"];
  t_stop [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>进入 ptrace-stop</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">获取锁</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">保存信号、寄存器、event 到锁内</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">置 is_stopped = true</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">释放锁</FONT></TD></TR></TABLE>>, fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.3", height="1.42", pos="200,470"];
  t_park [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>挂起，等待 tracer</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">pause_until(!is_stopped)</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">SIGKILL 可随时打断</FONT></TD></TR></TABLE>>, fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.3", height="0.92", pos="200,345"];
  t_wake [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>被唤醒，继续运行</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">获取锁，读回快照</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">释放锁</FONT></TD></TR></TABLE>>, fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.3", height="0.92", pos="200,238"];
  r_wait [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>wait 报告</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">获取锁</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">取 wait4 状态后释放锁</FONT></TD></TR></TABLE>>, fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.4", height="0.92", pos="800,488"];
  r_inspect [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>读 / 改寄存器、内存</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">获取锁，检查 is_stopped</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">读 / 写寄存器快照、读 / 写用户空间</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">释放锁</FONT></TD></TR></TABLE>>, fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.4", height="1.15", pos="800,360"];
  r_resume [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>resume</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">获取锁</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">注入 / 清除待决信号</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">置 is_stopped = false</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">释放锁</FONT></TD></TR></TABLE>>, fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.4", height="1.42", pos="800,228"];
  c_mtx [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>state: Mutex&lt;TraceeState&gt;</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11">寄存器快照、待决信号、event、options</FONT></TD></TR></TABLE>>, fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.3", height="0.72", pos="500,378"];
  c_atom [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="11"><B>is_stopped: AtomicBool</B></FONT></TD></TR></TABLE>>, fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, fixedsize=true, width="3.3", height="0.46", pos="500,323"];
  t_stop:s -> t_park:n [color="#2F9D57"];
  r_wait:s -> r_inspect:n [color="#C8881A"];
  r_inspect:s -> r_resume:n [color="#C8881A"];
  tracee_grp:e -> center_grp:w [dir=both, color="#6F42C1", penwidth=2.2];
  tracer_grp:w -> center_grp:e [dir=both, color="#6F42C1", penwidth=2.2];
  wsig [shape=point, width=0.01, style=invis, pos="500,538"];
  t_stop:e -> wsig [color="#2F9D57", arrowhead=none];
  wsig -> r_wait:w [color="#2F9D57"];
  L_sig [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#1c6035", pos="500,525", label="向tracer发送 SIGCHLD
唤醒挂起在 wait 的 tracer"];
  wwake [shape=point, width=0.01, style=invis, pos="500,188"];
  r_resume:w -> wwake [color="#C8881A", arrowhead=none];
  wwake -> t_wake:e [color="#C8881A"];
  L_wk [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#7a5200", pos="500,202", label="唤醒挂起在 ptrace stop 的 tracee"];
}
