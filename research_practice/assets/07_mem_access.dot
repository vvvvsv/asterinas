digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.16,0.10", fontsize=13];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  src1 [label="ptrace PEEK/POKE", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="170,555"];
  src2 [label="/proc/&lt;pid&gt;/mem", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="350,555"];
  entry [label="跨进程地址空间访问\n统一抽象 access_alien()", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="260,485"];
  query [label="逐页查询目标地址空间页表\n的映射与权限（不真正切换页表）", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="260,410"];
  frame [label="命中物理页帧\n直接拷贝数据", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="110,300"];
  fcond [label="页面缺失 / 权限不足", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="520,410"];
  fmake [label="伪造一次对该地址的缺页", fillcolor="#F8F6E0", color="#9A9620", fontcolor="#5f5c10", pos="520,350"];
  fhandle [label="复用内核真实缺页处理\nhandle_page_fault", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="520,280"];
  src1:s -> entry;
  src2:s -> entry;
  entry:s -> query:n;
  query:w -> frame:n [color="#2F9D57"];
  query:e -> fcond:w [color="#C0463F"];
  fcond:s -> fmake:n [color="#5b6b7d"];
  fmake:s -> fhandle:n [color="#5b6b7d"];
  wr1 [shape=point, width=0.01, style=invis, pos="260,280"];
  fhandle:w -> wr1 [arrowhead=none, color="#5b6b7d"];
  wr1 -> query:s [color="#5b6b7d"];
  l_hit [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#1c6035", pos="162,353", label="页表命中"];
  l_miss [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#7d2723", pos="410,431", label="未命中"];
  l_retry [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#3a4a5c", pos="325,302", label="处理完重试"];
}
