digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.16,0.10", fontsize=13];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  src1 [label="ptrace PEEK / POKE", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="190,560"];
  src2 [label="/proc/&lt;pid&gt;/mem", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="450,560"];
  chk [label="权限 + 停止态检查", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", pos="320,460"];
  entry [label="read_alien / write_alien / fill_zeros_alien\n统一收敛到 access_alien() 原语", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="320,360"];
  query [label="query_page_with_required_flags\n按页查询目标进程的地址空间映射、权限\n（不切换页表、不切换地址空间）", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="320,250"];
  frame [label="命中物理页帧\n直接拷贝数据", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="110,95"];
  fault [label="缺页 / 权限不足\n主动触发缺页处理后重试", fillcolor="#F8F6E0", color="#9A9620", fontcolor="#5f5c10", pos="565,95"];
  src1:s -> chk:nw;
  src2:s -> chk:ne;
  chk:s -> entry:n;
  entry:s -> query:n;
  jct [shape=point, width=0.01, style=invis, pos="320,180"];
  query:s -> jct [arrowhead=none, color="#5b6b7d"];
  jct -> frame:ne [color="#2F9D57"];
  jct -> fault:nw [color="#C0463F"];
  wp1 [shape=point, width=0.01, style=invis, pos="710,95"];
  wp2 [shape=point, width=0.01, style=invis, pos="710,250"];
  fault:e -> wp1 [arrowhead=none, color="#C0463F", style=dashed];
  wp1 -> wp2 [arrowhead=none, color="#C0463F", style=dashed];
  wp2 -> query:e [color="#C0463F", style=dashed];
  l_frame [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#1c6035", pos="225,150", label="映射存在且权限满足"];
  l_fault [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#7d2723", pos="405,150", label="需要处理"];
  l_retry [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#7d2723", pos="710,175", label="重试"];
}
