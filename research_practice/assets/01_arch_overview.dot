digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.25", splines=true];
  node [fontname="PingFang SC"];
  edge [fontname="PingFang SC", arrowsize=0.85];
  user [shape=box, style="rounded,filled", fillcolor="#FFF3DC40", color="#C8881A", penwidth=1.6, pos="0,500", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#7a5200"><B>① USER APP（GDB / strace）</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#C8881A" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#FFF3DC"><FONT POINT-SIZE="11" COLOR="#7a5200">GDB 调试器</FONT></TD><TD BGCOLOR="#FFF3DC"><FONT POINT-SIZE="11" COLOR="#7a5200">strace 跟踪器</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  sys [shape=box, style="rounded,filled", fillcolor="#E7F0FF40", color="#2F5FA8", penwidth=1.6, pos="0,400", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#1d3a66"><B>② 系统调用接口（Linux ABI）</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#2F5FA8" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#E7F0FF"><FONT POINT-SIZE="11" COLOR="#1d3a66">sys_ptrace<BR/>系统调用分发</FONT></TD><TD BGCOLOR="#E7F0FF"><FONT POINT-SIZE="11" COLOR="#1d3a66">/proc 文件接口<BR/>maps, mem, ...</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  perm [shape=box, style="rounded,filled", fillcolor="#F1E9FF40", color="#6F42C1", penwidth=1.6, pos="250,360", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#48227f"><B>③ 权限检查（统一鉴权）</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#6F42C1" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#F1E9FF"><FONT POINT-SIZE="11" COLOR="#48227f">Yama LSM<BR/>ptrace_scope 策略</FONT></TD><TD BGCOLOR="#F1E9FF"><FONT POINT-SIZE="11" COLOR="#48227f">alien access 凭证<BR/>Read/Attach, Fs/Real</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  sm [shape=box, style="rounded,filled", fillcolor="#E5F8EE33", color="#2F9D57", penwidth=1.6, pos="0,258", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#1c6035"><B>④ tracer / tracee 状态机</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#2F9D57" CELLSPACING="3" CELLPADDING="3"><TR><TD  BGCOLOR="#E5F8EE"><FONT POINT-SIZE="11" COLOR="#1c6035">建立关系<BR/>TRACEME / attach</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="12" COLOR="#1c6035">&#8594;</FONT></TD><TD PORT="pstop" BGCOLOR="#E5F8EE"><FONT POINT-SIZE="11" COLOR="#1c6035">ptrace-stop<BR/>保存现场, 阻塞</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="12" COLOR="#1c6035">&#8594;</FONT></TD><TD  BGCOLOR="#E5F8EE"><FONT POINT-SIZE="11" COLOR="#1c6035">wait 报告<BR/>SIGCHLD &#8594; wait4</FONT></TD><TD BORDER="0"><FONT POINT-SIZE="12" COLOR="#1c6035">&#8594;</FONT></TD><TD PORT="pres" BGCOLOR="#E5F8EE"><FONT POINT-SIZE="11" COLOR="#1c6035">resume<BR/>CONT, STEP, SYSCALL</FONT></TD></TR><TR><TD COLSPAN="7" BORDER="0" HEIGHT="30"><FONT POINT-SIZE="11" COLOR="#1c6035">                              再停止（resume 后命中新 stop）</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  alien [shape=box, style="rounded,filled", fillcolor="#FFEAEA40", color="#C0463F", penwidth=1.6, pos="-170,120", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#7d2723"><B>⑤ 跨进程用户空间读写</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#C0463F" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#FFEAEA"><FONT POINT-SIZE="11" COLOR="#7d2723">底层实现<BR/>VMAR alien access</FONT></TD><TD BGCOLOR="#FFEAEA"><FONT POINT-SIZE="11" COLOR="#7d2723">API<BR/>ptrace PEEK / POKE<BR/>/proc/pid/mem</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  reg [shape=box, style="rounded,filled", fillcolor="#E3F4F440", color="#1F8585", penwidth=1.6, pos="80,120", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#0f5151"><B>⑥ 寄存器上下文快照</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#1F8585" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#E3F4F4"><FONT POINT-SIZE="11" COLOR="#0f5151">CUserRegsStruct<BR/>USER area</FONT></TD><TD BGCOLOR="#E3F4F4"><FONT POINT-SIZE="11" COLOR="#0f5151">字段级写策略<BR/>rip/rsp/段寄存器 等</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  cowork [shape=box, style="rounded,filled", fillcolor="#F8F6E040", color="#9A9620", penwidth=1.6, pos="285,120", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD CELLPADDING="2"><FONT POINT-SIZE="13" COLOR="#5f5c10"><B>⑦ 与其他系统调用协作</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="1" COLOR="#9A9620" CELLSPACING="3" CELLPADDING="3"><TR><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">signal</FONT></TD><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">wait</FONT></TD><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">clone</FONT></TD></TR><TR><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">exec</FONT></TD><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">exit</FONT></TD><TD BGCOLOR="#F8F6E0"><FONT POINT-SIZE="11" COLOR="#5f5c10">fork</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  gate [shape=point, width=0.03, color="#5b6b7d", pos="0,340"];
  authlbl [shape=plaintext, pos="80,340", fontsize=12, fontcolor="#48227f", label="鉴权放行"];
  wp1 [shape=point, width=0.01, style=invis, pos="180,215"];
  wp2 [shape=point, width=0.01, style=invis, pos="-75,215"];

  user -> sys [penwidth=2.6, color="#5b6b7d"];
  sys -> gate [arrowhead=none, penwidth=2.6, color="#5b6b7d"];
  gate -> sm [penwidth=2.6, color="#5b6b7d"];
  perm:w -> gate [color="#6F42C1"];
  sm -> alien [penwidth=2.2, color="#5b6b7d"];
  sm -> reg [penwidth=2.2, color="#5b6b7d"];
  sm -> cowork [penwidth=2.2, color="#5b6b7d"];
  sm:pres:s -> wp1 [arrowhead=none, style=dashed, color="#2F9D57"];
  wp1 -> wp2 [arrowhead=none, style=dashed, color="#2F9D57"];
  wp2 -> sm:pstop:s [style=dashed, color="#2F9D57"];
}
