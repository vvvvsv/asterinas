digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.16,0.10", fontsize=13];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  trap [label="tracee 陷入内核\n保存用户寄存器上下文", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="880.0,480"];
  snap [label="进入 ptrace-stop\n持锁复制用户寄存器上下文到寄存器快照", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="880.0,400"];
  rule [label="tracer 持锁修改寄存器快照\n字段级访问策略", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", pos="880.0,320"];
  set [label="rax..r15\ntracer 自由修改", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="580,230"];
  setif [label="rip/rsp/fs/gsbase\n必须是用户地址", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="730,230"];
  trunc [label="rflags\n仅能写用户态可控位", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="880,230"];
  fixed [label="cs/ss/ds/es\n只读, 和 Linux 一致", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="1030,230"];
  dbg [label="debug regs\n只读, 未来支持写入", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="1180,230"];
  wb [label="tracee 唤醒\n快照写回寄存器上下文", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="880.0,130"];
  bus0 [shape=point, width=0.01, style=invis, pos="580,180"];
  bus1 [shape=point, width=0.01, style=invis, pos="730,180"];
  bus2 [shape=point, width=0.01, style=invis, pos="880,180"];
  bus3 [shape=point, width=0.01, style=invis, pos="1030,180"];
  bus4 [shape=point, width=0.01, style=invis, pos="1180,180"];
  trunk [shape=point, width=0.01, style=invis, pos="880.0,180"];

  trap -> snap [color="#5b6b7d"];
  snap -> rule [color="#5b6b7d"];
  rule:s -> set:n [color="#5b6b7d"];
  rule:s -> setif:n [color="#5b6b7d"];
  rule:s -> trunc:n [color="#5b6b7d"];
  rule:s -> fixed:n [color="#5b6b7d"];
  rule:s -> dbg:n [color="#5b6b7d"];
  set:s -> bus0 [arrowhead=none, color="#5b6b7d"];
  setif:s -> bus1 [arrowhead=none, color="#5b6b7d"];
  trunc:s -> trunk [arrowhead=none, color="#5b6b7d"];
  fixed:s -> bus3 [arrowhead=none, color="#5b6b7d"];
  dbg:s -> bus4 [arrowhead=none, color="#5b6b7d"];
  bus0 -> bus1 [arrowhead=none, color="#5b6b7d"];
  bus1 -> trunk [arrowhead=none, color="#5b6b7d"];
  bus4 -> bus3 [arrowhead=none, color="#5b6b7d"];
  bus3 -> trunk [arrowhead=none, color="#5b6b7d"];
  trunk -> wb:n [color="#5b6b7d"];
}
