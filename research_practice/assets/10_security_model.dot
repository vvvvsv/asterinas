  deny [label="拒绝 EPERM / EACCES", fillcolor="#FFEAEA", color="#C0463F", fontcolor="#7d2723", pos="430,20"];
  wp_uy [shape=point, width=0.001, color="white", pos="140,144.0"];
  req -> same [color="#5b6b7d"];
  same -> ugid [color="#5b6b7d"];
  ugid -> cap [color="#5b6b7d"];
  cap -> yama [color="#5b6b7d"];
  same:w -> allow:n [color="#2F9D57", penwidth=1.6, pos="e,70,42 70,388 70,110"];
  ugid:w -> wp_uy [color="#2F9D57", penwidth=1.6, arrowhead=none];
  wp_uy -> yama:w [color="#2F9D57", penwidth=1.6];
  cap:e -> deny:n [color="#C0463F", penwidth=1.6, pos="e,430,42 420,196 430,166"];
  yama:sw -> allow:e [color="#2F9D57", penwidth=1.6];
  yama:se -> deny:nw [color="#C0463F", penwidth=1.6];
  L_same_y [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#2F9D57", pos="92,254.0", label="是"];
  L_same_n [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#5b6b7d", pos="272,342.0", label="否"];
  L_ugid_y [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#2F9D57", pos="162,232.0", label="是"];
  L_ugid_n [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#5b6b7d", pos="272,246.0", label="否"];
  L_cap_y [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#5b6b7d", pos="272,144.0", label="是"];
  L_cap_n [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#C0463F", pos="450,138.0", label="否"];
  L_yama_p [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#2F9D57", pos="164,46", label="scope 通过"];
  L_yama_d [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#C0463F", pos="342,46", label="scope 拒绝"];
  scope_title [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#48227f", pos="650,362", label="Yama ptrace_scope"];
  y0 [label="0 Disabled、不额外限制", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", fontsize="11", margin="0.14,0.07", pos="650,300"];
  y1 [label="1 Relational（默认）、仅祖先 / CAP", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", fontsize="11", margin="0.14,0.07", pos="650,240"];
