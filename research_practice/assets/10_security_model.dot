  cap [label="具备\nCAP_SYS_PTRACE？", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", shape="diamond", style="filled", width="2.3", height="0.95", fixedsize="true", pos="250,196"];
  yama [label="Yama LSM hook", fillcolor="#F1E9FF", color="#6F42C1", fontcolor="#48227f", pos="250,92"];
