digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.1,0.06", fontsize=11];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  b1 [label="设置断点\n定位代码、写 int3", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="0,120", width="1.95", height="0.62", fixedsize="true"];
  b2 [label="命中 #BP → SIGTRAP\n进入 ptrace-stop", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="230,120", width="1.95", height="0.62", fixedsize="true"];
  b3 [label="wait 返回\n报告命中", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="460,120", width="1.95", height="0.62", fixedsize="true"];
  b4 [label="改 RIP\n恢复原指令", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="690,120", width="1.95", height="0.62", fixedsize="true"];
  b5 [label="设 TF\n单步执行一条", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="690,0", width="1.95", height="0.62", fixedsize="true"];
  b6 [label="单步 #DB\n再次 ptrace-stop", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="460,0", width="1.95", height="0.62", fixedsize="true"];
  b7 [label="重新写回 int3", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="230,0", width="1.95", height="0.62", fixedsize="true"];
  b8 [label="resume 继续", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="0,0", width="1.95", height="0.62", fixedsize="true"];
  leg_t [label="tracee（被调试程序）", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="230,205", width="2.4", height="0.42", fixedsize="true", fontsize="11"];
  leg_r [label="tracer（调试器）", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="510,205", width="2.4", height="0.42", fixedsize="true", fontsize="11"];
  b1:e -> b2:w [color="#5b6b7d"];
  b2:e -> b3:w [color="#5b6b7d"];
  b3:e -> b4:w [color="#5b6b7d"];
  b4:s -> b5:n [color="#5b6b7d"];
  b5:w -> b6:e [color="#5b6b7d"];
  b6:w -> b7:e [color="#5b6b7d"];
  b7:w -> b8:e [color="#5b6b7d"];
  lb1 [shape=point, width=0.01, style=invis, pos="-135,0"];
  lb2 [shape=point, width=0.01, style=invis, pos="-135,120"];
  b8:w -> lb1 [arrowhead=none, color="#C0463F"];
  lb1 -> lb2 [arrowhead=none, color="#C0463F"];
  lb2 -> b1:w [color="#C0463F"];
  fb [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#C0463F", pos="-135,60", label="再次命中"];
}
