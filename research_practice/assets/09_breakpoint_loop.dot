digraph G {
  graph [fontname="PingFang SC", bgcolor="white", pad="0.3", splines=true];
  node [fontname="PingFang SC", shape=box, style="rounded,filled", penwidth=1.5, margin="0.1,0.06", fontsize=11];
  edge [fontname="PingFang SC", color="#5b6b7d", penwidth=1.4, arrowsize=0.85, fontsize=11];
  bandA [label="", shape=box, style="rounded,filled", fillcolor="#EFF4FC", color="#9DB8DD", penwidth=1.4, fixedsize=true, width="10.7", height="2.55", pos="300,252"];
  bandB [label="", shape=box, style="rounded,filled", fillcolor="#F4EFFB", color="#C3ABE0", penwidth=1.4, fixedsize=true, width="10.7", height="2.55", pos="300,52"];
  ptitleA [shape=plaintext, style="filled", fillcolor="#EFF4FC", fontname="PingFang SC", fontcolor="#1d3a66", fontsize="12", label="阶段一　命中断点，回退一步并准备单步", pos="300,252"];
  ptitleB [shape=plaintext, style="filled", fillcolor="#F4EFFB", fontname="PingFang SC", fontcolor="#48227f", fontsize="12", label="阶段二　单步越过原指令后，恢复断点", pos="300,52"];
  b1 [label="命中 #BP\n→ SIGTRAP", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="0,300", width="1.85", height="0.56", fixedsize="true"];
  b2 [label="ptrace-stop\n保存现场", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="200,300", width="1.85", height="0.56", fixedsize="true"];
  b3 [label="wait(tracee)\n返回", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="400,300", width="1.85", height="0.56", fixedsize="true"];
  b4 [label="读寄存器 rip", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="600,300", width="1.85", height="0.56", fixedsize="true"];
  b5 [label="写寄存器\nrip -= 1", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="600,200", width="1.85", height="0.56", fixedsize="true"];
  b6 [label="写用户空间\n恢复原指令", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="400,200", width="1.85", height="0.56", fixedsize="true"];
  b7 [label="设置 CPU\ntrap flag", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="200,200", width="1.85", height="0.56", fixedsize="true"];
  b8 [label="resume tracee", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="0,200", width="1.85", height="0.56", fixedsize="true"];
  b9 [label="tracee 执行一步\n原指令后陷入内核", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="0,100", width="1.85", height="0.56", fixedsize="true"];
  b10 [label="命中 #DB\n→ SIGTRAP", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="200,100", width="1.85", height="0.56", fixedsize="true"];
  b11 [label="ptrace-stop\n保存现场", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="400,100", width="1.85", height="0.56", fixedsize="true"];
  b12 [label="wait(tracee)\n返回", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="600,100", width="1.85", height="0.56", fixedsize="true"];
  b13 [label="写用户空间\nINT3", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="600,0", width="1.85", height="0.56", fixedsize="true"];
  b14 [label="清除 CPU\ntrap flag", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="400,0", width="1.85", height="0.56", fixedsize="true"];
  b15 [label="resume tracee", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="200,0", width="1.85", height="0.56", fixedsize="true"];
  b16 [label="tracee 再次\n走到断点", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="0,0", width="1.85", height="0.56", fixedsize="true"];
  s1 [label="maps 定位代码映射", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="400,392", width="1.85", height="0.52", fixedsize="true"];
  s2 [label="PEEKTEXT 读原指令", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="200,392", width="1.85", height="0.52", fixedsize="true"];
  s3 [label="POKETEXT 写 int3", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="0,392", width="1.85", height="0.52", fixedsize="true"];
  s_hdr [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#7a5200", pos="200,432", label="设置断点（一次性）"];
  leg_t [label="tracee（被调试程序）执行", fillcolor="#E5F8EE", color="#2F9D57", fontcolor="#1c6035", pos="600,410", width="2.4", height="0.42", fixedsize="true", fontsize="11"];
  leg_r [label="tracer（调试器）操作", fillcolor="#FFF3DC", color="#C8881A", fontcolor="#7a5200", pos="600,368", width="2.4", height="0.42", fixedsize="true", fontsize="11"];
  s1:w -> s2:e [color="#5b6b7d"];
  s2:w -> s3:e [color="#5b6b7d"];
  s3:s -> b1:n [color="#5b6b7d"];
  b1:e -> b2:w [color="#5b6b7d"];
  b2:e -> b3:w [color="#5b6b7d"];
  b3:e -> b4:w [color="#5b6b7d"];
  b4:s -> b5:n [color="#5b6b7d"];
  b5:w -> b6:e [color="#5b6b7d"];
  b6:w -> b7:e [color="#5b6b7d"];
  b7:w -> b8:e [color="#5b6b7d"];
  b8:s -> b9:n [color="#5b6b7d"];
  b9:e -> b10:w [color="#5b6b7d"];
  b10:e -> b11:w [color="#5b6b7d"];
  b11:e -> b12:w [color="#5b6b7d"];
  b12:s -> b13:n [color="#5b6b7d"];
  b13:w -> b14:e [color="#5b6b7d"];
  b14:w -> b15:e [color="#5b6b7d"];
  b15:w -> b16:e [color="#5b6b7d"];
  lb1 [shape=point, width=0.01, style=invis, pos="-115,0"];
  lb2 [shape=point, width=0.01, style=invis, pos="-115,300"];
  b16:w -> lb1 [arrowhead=none, color="#C0463F"];
  lb1 -> lb2 [arrowhead=none, color="#C0463F"];
  lb2 -> b1:w [color="#C0463F"];
  fb [shape=box, style="filled", fillcolor="white", color="white", penwidth=0, margin="0.03,0.01", fontsize=11, fontcolor="#C0463F", pos="-115,152", label="再次命中"];
}
