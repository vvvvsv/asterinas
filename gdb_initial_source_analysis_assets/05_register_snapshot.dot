digraph G {
  graph [fontname="Noto Sans CJK SC", bgcolor="white", rankdir=LR, pad="0.25", nodesep="0.5", ranksep="0.55"];
  node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", color="#2f4f6f", fillcolor="#edf5ff", penwidth=1.4, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK SC", color="#4b6278", penwidth=1.3, arrowsize=0.8];

  trap [label="tracee 陷入内核\nsignal/syscall/exec/exit", fillcolor="#fff4df", color="#b57900"];
  snapshot [label="进入 ptrace-stop\n复制 GeneralRegs + FS/GS + orig_rax\n到 TraceeState", fillcolor="#eefcf3", color="#2f7d46"];
  tracer [label="tracer 请求\nGETREGS/SETREGS/PEEKUSER/POKEUSER", fillcolor="#edf5ff", color="#2f4f6f"];
  validate [label="arch/x86/ptrace.rs\nLinux ABI + 寄存器合法性检查"];
  resume [label="CONT/SYSCALL/SINGLESTEP\n修改快照中的 TF/syscall 标志"];
  writeback [label="tracee 被唤醒\n快照写回 UserContext\n再回用户态", fillcolor="#eefcf3", color="#2f7d46"];
  fastpath [label="未被 ptrace 的线程\n不持有 user_context 锁\n避免额外 atomic 开销", fillcolor="#fff0f0", color="#a33a3a"];

  trap -> snapshot;
  snapshot -> tracer;
  tracer -> validate;
  validate -> snapshot [label="读/改 TraceeState 副本"];
  snapshot -> resume;
  resume -> writeback;
  fastpath -> trap [style=dashed, label="仅命中正常陷入路径"];
}