digraph G {
  graph [fontname="Noto Sans CJK SC", bgcolor="white", rankdir=LR, pad="0.25", nodesep="0.5", ranksep="0.55"];
  node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", color="#2f4f6f", fillcolor="#edf5ff", penwidth=1.4, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK SC", color="#4b6278", penwidth=1.3, arrowsize=0.8];

  user [label="用户态\nGDB / strace", fillcolor="#fff4df", color="#b57900"];
  ptrace [label="sys_ptrace\nkernel/src/syscall/ptrace.rs"];
  perm [label="权限检查\nalien_access.rs + Yama LSM", fillcolor="#f5edff", color="#6f42c1"];
  state [label="Tracer / Tracee 状态机\nprocess/posix_thread/ptrace", fillcolor="#eefcf3", color="#2f7d46"];
  wait [label="wait/waitpid 报告\nTraceeStop / TraceeExit", fillcolor="#eefcf3", color="#2f7d46"];
  mem [label="远程内存\nread_alien / write_alien", fillcolor="#fff0f0", color="#a33a3a"];
  regs [label="寄存器快照\nCUserRegsStruct / USER area", fillcolor="#fff0f0", color="#a33a3a"];
  proc [label="/proc/[pid]/*\nmem/cmdline/environ/auxv/maps", fillcolor="#eef7f7", color="#257070"];
  events [label="事件协作\nsyscall / signal / exec / exit / clone", fillcolor="#f7f7e8", color="#77772d"];

  user -> ptrace [label="ptrace(2)"];
  ptrace -> perm [label="TRACEME/attach"];
  ptrace -> state [label="get_tracee / continue"];
  state -> wait [label="SIGCHLD + wait"];
  state -> mem [label="PEEK/POKE"];
  state -> regs [label="GETREGS/SETREGS"];
  user -> proc [label="open/read/write"];
  proc -> perm [label="READ/ATTACH mode"];
  proc -> mem [label="复用 VMAR 访问"];
  events -> state [label="触发 ptrace-stop"];
}