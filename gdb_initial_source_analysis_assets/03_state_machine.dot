digraph G {
  graph [fontname="Noto Sans CJK SC", bgcolor="white", rankdir=LR, pad="0.25", nodesep="0.5", ranksep="0.55"];
  node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", color="#2f4f6f", fillcolor="#edf5ff", penwidth=1.4, margin="0.12,0.08"];
  edge [fontname="Noto Sans CJK SC", color="#4b6278", penwidth=1.3, arrowsize=0.8];

  node [shape=ellipse, style="filled", fillcolor="#edf5ff", color="#2f4f6f"];
  untraced [label="未被跟踪\ntracee_status 未初始化/无 tracer"];
  attached [label="已建立 trace 关系\ntracer.tracees + tracee.tracer"];
  stopped [label="ptrace-stop\n保存 signal/event/regs\nis_stopped = true"];
  reported [label="wait 报告\nTraceeStop / siginfo"];
  running [label="恢复运行\n写回寄存器快照\nis_stopped = false"];
  exited [label="退出/清理\nTraceeExit + detach"];

  untraced -> attached [label="TRACEME / attach_to"];
  attached -> stopped [label="signal/syscall/exec/exit event"];
  stopped -> reported [label="SIGCHLD + wait"];
  reported -> stopped [label="WNOWAIT 或尚未 continue"];
  stopped -> running [label="CONT/SYSCALL/SINGLESTEP"];
  running -> stopped [label="下一次 stop 条件"];
  stopped -> exited [label="SIGKILL interrupt / exit"];
  running -> exited [label="exit"];
}